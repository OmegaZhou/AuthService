diff --git a/internal/handlers/handler_email_otp.go b/internal/handlers/handler_email_otp.go
new file mode 100644
--- /dev/null
+++ b/internal/handlers/handler_email_otp.go
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: Apache-2.0
+package handlers
+
+import (
+	html "html/template"
+	"net/mail"
+	"os"
+	"strings"
+	text "text/template"
+
+	"github.com/authelia/authelia/v4/internal/emailotp"
+	"github.com/authelia/authelia/v4/internal/middlewares"
+	"github.com/authelia/authelia/v4/internal/templates"
+)
+
+func EmailOTPEnabled() bool { return os.Getenv("AUTH_LOGIN_MODE") == "email_otp" }
+
+var loginChallenges = &emailotp.Manager{Path: os.Getenv("AUTH_EMAIL_OTP_STATE")}
+
+type emailOTPAccount struct{ ctx *middlewares.AutheliaCtx }
+
+func (a emailOTPAccount) SetPassword(user, password string) error {
+	return a.ctx.Providers.UserProvider.UpdatePassword(user, password)
+}
+func (a emailOTPAccount) CheckPassword(user, password string) (bool, error) {
+	return a.ctx.Providers.UserProvider.CheckUserPassword(user, password)
+}
+
+func EmailOTPConfigurationGET(ctx *middlewares.AutheliaCtx) {
+	_ = ctx.SetJSONBody(struct {
+		Enabled bool `json:"enabled"`
+	}{EmailOTPEnabled()})
+}
+
+var loginEmailTemplate = &templates.EmailTemplate{
+	Text: text.Must(text.New("login").Parse("Your login password: {{.Password}}\nValid for 15 minutes, one use only. Do not share it.\nIf you did not request this login, ignore this message.")),
+	HTML: html.Must(html.New("login").Parse("<h2>登录临时密码</h2><p><code style='font-size:20px;overflow-wrap:anywhere;word-break:break-all;user-select:all'>{{.Password}}</code></p><p>请复制完整密码，区分大小写。15 分钟内有效，仅能使用一次。请勿转发。如果不是你发起的登录，请忽略。</p>")),
+}
+
+func EmailOTPRequestPOST(ctx *middlewares.AutheliaCtx) {
+	if !EmailOTPEnabled() || ctx.Configuration.Notifier.SMTP == nil || loginChallenges.Path == "" {
+		ctx.SetStatusCode(404)
+		ctx.SetJSONError("Unavailable")
+		return
+	}
+	var body struct {
+		Username string `json:"username"`
+	}
+	if ctx.ParseBody(&body) != nil || len(body.Username) > 320 {
+		ctx.SetStatusCode(400)
+		ctx.SetJSONError("Invalid request")
+		return
+	}
+	username := strings.ToLower(strings.TrimSpace(body.Username))
+	address, err := mail.ParseAddress(username)
+	if err != nil || address.Address != username {
+		ctx.SetStatusCode(400)
+		ctx.SetJSONError("Enter an email address")
+		return
+	}
+	details, err := ctx.Providers.UserProvider.GetDetails(username)
+	// Resolve only pre-provisioned canonical email usernames, never arbitrary recipients or aliases.
+	if err == nil && details != nil && details.Username == username {
+		err = loginChallenges.Issue(username, emailOTPAccount{ctx}, func(user, password string) error {
+			return ctx.Providers.Notifier.Send(ctx, mail.Address{Address: user}, "Your one-time login password", loginEmailTemplate, struct{ Password string }{password})
+		})
+		if err != nil {
+			ctx.Logger.Error("Email login request failed")
+			ctx.SetStatusCode(503)
+			ctx.SetJSONError("Unable to send login email; try later")
+			return
+		}
+	}
+	_ = ctx.SetJSONBody(struct {
+		Message string `json:"message"`
+	}{"If this account exists, check its mailbox. Requests within 15 minutes do not resend or replace the password."})
+}
