[Unit]
Description=Shared plugin account authentication (Authelia)
After=network-online.target
Wants=network-online.target

[Service]
User=gpt-plugin-oauth
Group=gpt-plugin-oauth
ExecStart=/opt/gpt-plugin-oauth/authelia --config /etc/gpt-plugin-oauth/configuration.yml
Restart=on-failure
RestartSec=5
StateDirectory=gpt-plugin-oauth
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gpt-plugin-oauth

[Install]
WantedBy=multi-user.target
